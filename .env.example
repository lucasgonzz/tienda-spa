# Este archivo es nuevo (no existia .env.example antes de este cambio, grupo 220 prompt 04).
# Por ahora solo documenta la(s) variable(s) que introdujo esa remediacion de secretos;
# NO es un espejo completo de todas las variables usadas por el proyecto (eso queda
# pendiente como deuda tecnica de prioridad baja, a completar gradualmente).

# Google Maps (public/index.html). No es secreta (index.html se sirve tal cual, la key
# sigue viajando visible al navegador), pero se saca del codigo para poder rotarla sin
# tocar codigo. La proteccion real es restringirla en Google Cloud Console (por API
# habilitada y por dominio/referrer HTTP).
VUE_APP_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (public/firebase-messaging-sw.js). Las keys de Firebase estan
# pensadas para ser publicas por diseno (viajan igual en el bundle de cualquier app
# Firebase): la proteccion real son las reglas de seguridad de Firebase y la restriccion
# por app/dominio en la consola de Firebase, no ocultar el valor. Se inyecta en tiempo de
# build via vue.config.js (transform del CopyWebpackPlugin sobre ese archivo estatico).
VUE_APP_FIREBASE_API_KEY=
